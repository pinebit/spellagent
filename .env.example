# Copy to .env for local reference. Never commit real credentials.
# SpellAgent does not automatically load .env files.
# Phase 0 live smoke reads existing process environment variables only.
# Set only the key for your selected connection:

# Direct OpenAI through Vercel AI SDK:
OPENAI_API_KEY=

# Direct Anthropic through Vercel AI SDK:
ANTHROPIC_API_KEY=

# Vercel AI Gateway through Vercel AI SDK (no direct-provider keys required):
AI_GATEWAY_API_KEY=
