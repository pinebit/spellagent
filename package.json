{
  "name": "spellagent",
  "version": "0.0.0",
  "private": true,
  "description": "Host-native proofreading plugins for Codex and Claude Code",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:plugins": "npm run build && node scripts/build-plugins.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test && npm run probe",
    "probe": "node dist/probes/offline.js",
    "test:pack": "node scripts/test-plugin-pack.mjs",
    "test:linux": "bash scripts/test-linux.sh"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "web-tree-sitter": "0.27.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinebit/spellagent.git"
  },
  "homepage": "https://github.com/pinebit/spellagent#readme",
  "bugs": {
    "url": "https://github.com/pinebit/spellagent/issues"
  },
  "keywords": [
    "codex-plugin",
    "claude-code-plugin",
    "spell-checker",
    "grammar-checker",
    "documentation",
    "typescript",
    "tree-sitter"
  ]
}
